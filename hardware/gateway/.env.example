(# Gateway configuration example)
# Destination server for HTTP POSTs
SERVER_URL=http://localhost:3000/api/readings
# Serial port for LoRa module
LORA_PORT=/dev/ttyUSB0
# Interval when running in dummy polling mode
INTERVAL_SECONDS=60
# Optional device key included with each payload
DEVICE_KEY=default-device-key
# Time window (seconds) for hop deduplication
HOPS_WINDOW_SECONDS=2.0
# Accept raw unsigned LoRa messages (true/false). Default: false
# WARNING: enabling this disables signature verification — use only in trusted environments
ALLOW_RAW_LORA=false

